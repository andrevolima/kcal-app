# Django
DJANGO_ENVIRONMENT=development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# JWT (utilizado a partir da Etapa 1B; não reutilize DJANGO_SECRET_KEY)
JWT_SIGNING_KEY=change-me-with-an-independent-random-secret
JWT_ACCESS_MINUTES=5
JWT_REFRESH_DAYS=7
JWT_REFRESH_COOKIE_SECURE=False
JWT_REFRESH_COOKIE_SAMESITE=Lax

# Rate limiting (proteção básica; não substitui controles no proxy/WAF)
THROTTLE_RATE_ANONYMOUS=100/hour
THROTTLE_RATE_AUTHENTICATED=1000/hour
THROTTLE_RATE_AUTH_LOGIN=5/minute
THROTTLE_RATE_TOKEN_REFRESH=10/minute
THROTTLE_RATE_SENSITIVE=10/minute

# PostgreSQL
DB_NAME=kcal
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Frontend (opcional; vazio usa o proxy do Vite)
VITE_API_URL=
